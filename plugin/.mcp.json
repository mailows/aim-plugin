{
  "mcpServers": {
    "aim": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--python",
        "3.14",
        "--with-requirements",
        "${CLAUDE_PLUGIN_ROOT}/server/requirements.txt",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/server/aim_channel.py"
      ],
      "env": {
        "AIM_RELAY_URL": "${user_config.relay_url}"
      }
    }
  }
}
